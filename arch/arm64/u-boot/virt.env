kernel_addr_r=0x41000000
ramdisk_addr_r=0x48000000
ramdisk_sz=0x800000

# Hand the ramdisk to the kernel where it was loaded; do not let U-Boot
# relocate it (its lmb has no spare space here, which otherwise fails as
# "alloc space exhausted" and mangles the ramdisk).
initrd_high=0xffffffff

bootcmd=booti ${kernel_addr_r} ${ramdisk_addr_r}:${ramdisk_sz} ${fdt_addr}
bootdelay=0
preboot=setenv fdt_addr ${fdtcontroladdr}; fdt addr ${fdtcontroladdr};
